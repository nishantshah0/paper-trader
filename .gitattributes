# LF in the repository and in the working tree on every OS.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Build wrappers and shell scripts must stay LF.
mvnw text eol=lf
gradlew text eol=lf
*.sh text eol=lf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
