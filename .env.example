# Copy to .env for Docker Compose. Never commit real API keys.
FEED_MODE=demo
# To use Finnhub quotes, set FEED_MODE=finnhub and provide your key.
FINNHUB_API_KEY=
# 12 symbols every 15 seconds is up to 48 quote requests per minute.
# Set this to fit your provider plan; errors keep the last quote.
FEED_INTERVAL_MS=15000
